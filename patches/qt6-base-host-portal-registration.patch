+    if (QGuiApplication::desktopFileName().isEmpty()) {
+        qCInfo(lcQpaServices) << "QGuiApplication::desktopFileName not set. Unable to register application with portal registry";
         return;
     }

+    // Portal activation can deliver serviceOwnerChanged while this call is
+    // pending. A connection must register only once with each portal owner.
+    state.pending = true;
+    const auto generation = state.generation;
     auto message = QDBusMessage::createMethodCall(
