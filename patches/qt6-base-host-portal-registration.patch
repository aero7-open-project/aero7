+
+void hostPortalOwnerChanged(const QString &, const QString &oldOwner, const QString &newOwner)
+{
+    auto &state = hostPortalRegistrationState();
+    // More than one platform-services object can watch the same owner change.
+    // Invalidate once, not once per watcher. Initial activation (empty oldOwner)
+    // must not invalidate an in-flight registration to the newly started portal.
+    if (oldOwner != state.previousOwner || newOwner != state.currentOwner) {
+        state.previousOwner = oldOwner;
+        state.currentOwner = newOwner;
+        if (!oldOwner.isEmpty()) {
+            state.registered = false;
+            state.pending = false;
+            ++state.generation;
+        }
+    }
+    if (!newOwner.isEmpty())
+        registerWithHostPortal();
+}
