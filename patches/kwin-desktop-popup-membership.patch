+bool XdgPopupWindow::belongsToDesktop() const
+{
+    // A desktop component's menus are part of that component, including nested
+    // popups. Mapping one must not restore applications hidden by Show Desktop.
+    // Inherit only through the popup parent; ordinary application windows and
+    // popups of unrelated layer-shell clients retain their existing behavior.
+    const Window *parent = transientFor();
+    return parent && parent->belongsToDesktop();
+}
