+bool LayerShellV1Window::belongsToDesktop() const
+{
+    // These are desktop widgets, not wallpaper windows or panels. Preserve
+    // their normal focus/stacking rules while excluding them from Show Desktop
+    // hiding. The transparent drag preview must follow the same visibility rule.
+    const QString scope = m_shellSurface->scope();
+    return scope == QLatin1String("aero7-desktop-gadgets")
+        || scope == QLatin1String("aero7-gadget-drag-preview");
+}
